graph TD
    %% Styling
    classDef entity fill:#EAF3DE,stroke:#2E5E3E,stroke-width:2px,color:#2E5E3E;
    classDef process fill:#E8F0FE,stroke:#4285F4,stroke-width:2px,color:#1A73E8;
    classDef datastore fill:#FFFFFF,stroke:#999999,stroke-width:1.5px,color:#333333;
    classDef external fill:#FFF2CC,stroke:#D6B656,stroke-width:2px,color:#5A4A1C;

    %% External Entities (Users)
    PetOwner(["Pet Owner"])
    ClinicStaff(["Clinic Staff"])
    SuperAdmin(["Super Admin"])

    %% Core Processes
    P1["1.0<br>Manage User Accounts"]
    P2["2.0<br>Manage Appointments"]
    P3["3.0<br>Manage Online Consultations"]
    P4["4.0<br>Monitor Pet Health"]
    P5["5.0<br>Process Product Orders"]
    P6["6.0<br>Handle Billing and Payments"]
    P7["7.0<br>Send Notifications"]

    %% Data Stores
    D1[("D1: Users")]
    D2[("D2: Pets")]
    D3[("D3: Appointments")]
    D4[("D4: Telemedicine")]
    D5[("D5: Pet Monitoring")]
    D6[("D6: Products")]
    D7[("D7: Orders")]
    D8[("D8: Payments")]

    %% External Services
    SMSService(["SMS Service"])
    PayService(["Payment Service"])

    %% === DATA FLOWS ===

    %% User Account Flows
    PetOwner -- "Registration details" --> P1
    ClinicStaff -- "Staff account info" --> P1
    SuperAdmin -- "Manage user roles" --> P1
    P1 -- "Save account" --> D1
    D1 -- "Retrieve user info" --> P1
    P1 -- "Login confirmation" --> PetOwner
    P1 -- "Login confirmation" --> ClinicStaff

    %% Appointment Flows
    PetOwner -- "Appointment request" --> P2
    P2 -- "Save appointment" --> D3
    D3 -- "Retrieve appointments" --> P2
    D2 -- "Pet details" --> P2
    P2 -- "Appointment status" --> PetOwner
    ClinicStaff -- "Approve or decline" --> P2
    P2 -- "Updated schedule" --> ClinicStaff

    %% Online Consultation Flows
    PetOwner -- "Consultation request" --> P3
    P3 -- "Save consultation" --> D4
    D4 -- "Retrieve session" --> P3
    ClinicStaff -- "Start consultation" --> P3
    P3 -- "Session link" --> PetOwner
    P3 -- "Diagnosis and prescription" --> PetOwner

    %% Pet Monitoring Flows
    PetOwner -- "Symptom report" --> P4
    P4 -- "Save monitoring data" --> D5
    D5 -- "Retrieve health records" --> P4
    D2 -- "Pet profile" --> P4
    P4 -- "Health alerts" --> PetOwner
    ClinicStaff -- "Review health report" --> P4
    P4 -- "Monitoring summary" --> ClinicStaff

    %% Product Order Flows
    PetOwner -- "Browse and order" --> P5
    P5 -- "Check stock" --> D6
    D6 -- "Product details" --> P5
    P5 -- "Save order" --> D7
    D7 -- "Order details" --> P5
    P5 -- "Order confirmation" --> PetOwner
    ClinicStaff -- "Update products" --> P5

    %% Billing and Payment Flows
    P2 -- "Appointment charges" --> P6
    P3 -- "Consultation charges" --> P6
    P5 -- "Order total" --> P6
    P6 -- "Process payment" --> PayService
    PayService -- "Payment result" --> P6
    P6 -- "Save payment" --> D8
    P6 -- "Payment receipt" --> PetOwner
    P6 -- "Payment report" --> ClinicStaff
    SuperAdmin -- "View billing reports" --> P6

    %% Notification Flows
    P2 -- "Appointment reminder" --> P7
    P3 -- "Consultation reminder" --> P7
    P4 -- "Health alert" --> P7
    P7 -- "Send SMS" --> SMSService
    SMSService -- "Delivery status" --> P7
    P7 -- "Push notification" --> PetOwner

    %% Styling
    class PetOwner,ClinicStaff,SuperAdmin entity;
    class P1,P2,P3,P4,P5,P6,P7 process;
    class D1,D2,D3,D4,D5,D6,D7,D8 datastore;
    class SMSService,PayService external;
