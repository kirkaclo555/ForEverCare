graph TD
    %% Global Link Styling for Cyan Arrows
    linkStyle default stroke:#00D2D2,stroke-width:3px;

    %% Class Definitions
    classDef greenShape fill:#2E5E3E,stroke:#1E3E28,color:#FFFFFF,stroke-width:2px;
    classDef startStop fill:#3B7A51,stroke:#2E5E3E,color:#FFFFFF,stroke-width:2px;
    classDef forkJoin fill:#000000,stroke:#000000,color:#FFFFFF,stroke-width:3px;

    subgraph SuperAdmin [Super Admin Actions]
        Start((●)) --> OpenPortal(Open Super Admin Portal)
        OpenPortal --> InputCredentials(Input Super Admin Credentials)
        
        Dashboard(Access Super Admin Dashboard) --> ChooseUsers(Manage User Roles)
        ChooseUsers --> ActUser(Select Profile & Assign New Role)
        
        Dashboard --> ChooseArchive(Access Global Record Archive)
        ChooseArchive --> ActRestore(Select Deleted Record & Click Restore)
        
        Dashboard --> ClickLogout(Click Logout Button)
    end

    subgraph System [Platform Backend]
        InputCredentials --> ValidateLogin{Verify Super Admin Session}
        ValidateLogin -- Invalid --> AlertLogin(Show Login Error) --> InputCredentials
        ValidateLogin -- Valid --> Dashboard
        
        ActUser --> WriteUserDB(Update account role in Users DB)
        WriteUserDB --> ShowUserOk(Print 'Permissions Updated' Message) --> Dashboard
        
        ActRestore --> ForkRestore[ ]
        class ForkRestore forkJoin;
        
        ForkRestore --> WriteRestoreDB(Set IsDeleted = false on Table Record)
        ForkRestore --> LogRestore(Write Security Audit Trail Record)
        
        WriteRestoreDB --> JoinRestore[ ]
        LogRestore --> JoinRestore
        class JoinRestore forkJoin;
        
        JoinRestore --> ShowRestoreOk(Print 'Record Restored' Message) --> Dashboard
        
        ClickLogout --> DestroySession(Clear Super Admin JWT Session)
        DestroySession --> End(((◎)))
    end

    class Start,End startStop;
    class OpenPortal,InputCredentials,ChooseUsers,ActUser,ChooseArchive,ActRestore,ClickLogout greenShape;
    class AlertLogin,WriteUserDB,ShowUserOk,WriteRestoreDB,LogRestore,ShowRestoreOk,DestroySession greenShape;
